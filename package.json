{
  "name": "jukben",
  "version": "2.0.0",
  "description": "Haha... it's me!",
  "type": "module",
  "bin": {
    "jukben": "cli.js"
  },
  "files": [
    "cli.js",
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=esm --outfile=dist/jukben.js --loader:.js=jsx --loader:.jsx=jsx --external:chalk --external:ink --external:ink-big-text --external:ink-gradient --external:react",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "ink": "^5.0.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "ink-testing-library": "^4.0.0",
    "rolldown": "^1.0.0-beta",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
